<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LocalRouter agent for macOS (per-user LaunchAgent).
  Install:
    sed "s#__HOME__#$HOME#g" deploy/org.wporter.localrouter-agent.plist \
      > ~/Library/LaunchAgents/org.wporter.localrouter-agent.plist
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/org.wporter.localrouter-agent.plist
  Logs: ~/Library/Logs/localrouter-agent.log
  Runs in the GUI session so it can read the login Keychain (Claude Code's
  credentials) read-only via `security find-generic-password`.
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>org.wporter.localrouter-agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.local/bin/localrouter</string>
    <string>agent</string>
    <string>-config</string>
    <string>__HOME__/.config/localrouter/agent.yaml</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>
  <key>Umask</key><integer>63</integer>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/localrouter-agent.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/localrouter-agent.log</string>
</dict>
</plist>
